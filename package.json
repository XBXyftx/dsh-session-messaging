{
  "name": "dsh-session-messaging",
  "version": "0.1.0",
  "description": "Cross-session messaging for DeepSeek Harness: let user-launched sessions in one workspace message each other and coordinate tasks, declared write scopes, and conflicts.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "messaging",
    "multi-agent",
    "agent-collaboration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XBXyftx/dsh-session-messaging.git"
  },
  "homepage": "https://github.com/XBXyftx/dsh-session-messaging#readme",
  "bugs": {
    "url": "https://github.com/XBXyftx/dsh-session-messaging/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/protocol.test.ts",
    "test:integration": "node --experimental-strip-types tests/integration-smoke.ts",
    "test:model-e2e": "node --experimental-strip-types tests/model-e2e-smoke.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
